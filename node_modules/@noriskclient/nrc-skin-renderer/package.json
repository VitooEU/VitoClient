{
  "name": "@noriskclient/nrc-skin-renderer",
  "version": "0.10.1",
  "description": "Three.js powered Minecraft skin, cosmetic and emote renderer",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoRiskClient/nrc-skin-renderer.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "default": "./dist/snapshot/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "default": "./dist/validate/index.js"
    },
    "./postfx": {
      "types": "./dist/postfx/index.d.ts",
      "default": "./dist/postfx/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "yarn build",
    "dev": "vite",
    "playground": "vite"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/fiber": "8.13.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.176.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11"
  }
}
